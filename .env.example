# Copy to .env to change the host-side exposure. Everything is optional.
#
# API_BIND=127.0.0.1 keeps the API on the loopback interface. Change to 0.0.0.0
# only if the host itself is the trust boundary (e.g. a bastion box).
API_BIND=127.0.0.1
API_PORT=8080

# Leave empty to use the rule set embedded in the binary.
# RULES_DIR=/etc/banner-fingerprint/rules

LOG_LEVEL=info
MAX_BATCH=5000
MAX_BODY_BYTES=8388608
WORKERS=0

VERSION=1.0.0

# Client side
SERVER_URL=http://server:8080
INPUT_FILE_HOST=./examples/sample_input.json
